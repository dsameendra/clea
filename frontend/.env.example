# Copy to .env.local to customise a build.

# "api" (default): talk to the Flask backend at /api.
# "static": search a pre-built index (public/data/index.json) in the browser — used for GitHub Pages.
VITE_SEARCH_MODE=api

# Path the site is served from. GitHub Pages project sites use "/<repo>/".
VITE_BASE=/

# Only for api mode when the API lives on another origin (also add that origin to CLEA_CORS_ORIGINS).
# VITE_API_BASE=https://search.example.com/api

# Absolute public URL of a static build; enables the OpenSearch description.
# VITE_PUBLIC_URL=https://you.github.io/clea/
